# Environment Configuration
# Copy to .env at repo root (gitignored). Never commit real secrets.
#   cp env.example .env
# Frontend-specific: cp packages/frontend/.env.example packages/frontend/.env
#
# Port matrix (local dev):
#   Backend (air / Go):     http://localhost:8080
#   Frontend (Vite):        http://localhost:5173  (app at /chaos/*)
#   MySQL:                  localhost:3306
# Screenshots / thumbs:     FRONTEND_URL=http://localhost:5173/chaos

# Backend Configuration
PORT=8080
ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=password
DB_NAME=canvasworld

# Frontend dev + screenshot service
VITE_PORT=5173
BACKEND_PORT=8080
FRONTEND_URL=http://localhost:5173/chaos
# Only set when the SPA must call the API on another origin (not needed for normal dev — Vite proxies /api):
# VITE_BACKEND_URL=http://127.0.0.1:8080

# Screenshot Configuration
IMAGES_DIR=static/images

# Public site URL for OG / canonical / sitemap (no trailing slash)
PUBLIC_BASE=https://matf.dev/chaos
# Deprecated alias — used only if PUBLIC_BASE is unset
PROD_URL=https://matf.dev/chaos
