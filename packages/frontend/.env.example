# Copy to .env and adjust. Never commit .env.

VITE_HOST=0.0.0.0
VITE_PUBLIC_HOST=localhost
VITE_PORT=5173
VITE_BACKEND_URL=http://127.0.0.1:9090

# Optional local HTTPS — generate into certs/ (gitignored):
#   mkdir -p certs && mkcert -key-file certs/localhost-key.pem -cert-file certs/localhost.pem localhost 127.0.0.1
# Or omit these and use HTTP only.
# VITE_HTTPS_KEY=./certs/localhost-key.pem
# VITE_HTTPS_CERT=./certs/localhost.pem
