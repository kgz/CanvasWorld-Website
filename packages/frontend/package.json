{
  "private": true,
  "name": "canvasworld-frontend",
  "version": "1.0.0",
  "description": "CanvasWorld Frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "fix": "eslint src --ext ts,tsx --fix --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "thumbs": "node scripts/capture-thumbs.mjs",
    "export-blog-posts": "node scripts/export-blog-posts.mjs",
    "validate-blog-embeds": "node scripts/validate-blog-embeds.mjs",
    "smoke:brusselator": "node scripts/smoke-brusselator.mjs"
  },
  "author": "Mat Frayne",
  "license": "ISC",
  "dependencies": {
    "@datapunt/matomo-tracker-react": "^0.5.1",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@react-three/drei": "^9.10.1",
    "@react-three/fiber": "^8.15.12",
    "@reduxjs/toolkit": "^1.9.7",
    "@types/three": "^0.159.0",
    "katex": "^0.16.25",
    "lucide-react": "^0.552.0",
    "react-helmet": "^6.1.0",
    "react-hot-toast": "^2.4.1",
    "react-katex": "^3.0.1",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.20.0",
    "redux-thunk": "^2.4.2",
    "three": "^0.159.0",
    "vite": "3"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/node": "^18.13.0",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@types/react-redux": "^7.1.31",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "@vitejs/plugin-react": "^4.0.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.49.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^27.0.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.6",
    "prettier": "^3.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.0",
    "typescript": "latest",
    "vitest": "^3.2.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "pnpm@9.0.0"
}
